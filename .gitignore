# Xcode — el .xcodeproj lo genera Scripts/bootstrap.sh (xcodegen generate) a partir de
# project.yml; no se versiona (PRD-APP-01).
*.xcodeproj/
DerivedData/
.DS_Store

# SwiftPM
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/

# xcodegen cache
.xcodegen/

# Simulator/test artifacts
*.xcresult

# Marker de verificación: es estado local ligado a un diff, no viaja
.claude/estado/
